# ---------------------------------------------------------------
# Unity generated — all regenerated from Assets/ + ProjectSettings/
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ee]xported[Oo]bj/

# Never ignore meta files inside Assets — a missing .meta means a new
# GUID on every machine, which silently breaks every reference to it.
!/[Aa]ssets/**/*.meta

# ---------------------------------------------------------------
# IDE / tooling
# ---------------------------------------------------------------
/.vs/
/.idea/
/.vscode/
/.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# ---------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
crashlytics-build.properties
sysinfo.txt

# ---------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------
.DS_Store
Thumbs.db

# NOTE: Packages/ (UPM manifest + packages-lock.json) is intentionally
# tracked — the lock file is what pins FishNet's exact commit for everyone.
# Assets/Packages/ (NuGetForUnity output) is also tracked on purpose, so a
# fresh clone compiles without needing a NuGet restore first.
