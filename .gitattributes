# Normalize line endings in the repository; check out native on each machine.
* text=auto

# ---------------------------------------------------------------
# Unity YAML — merged with UnityYAMLMerge rather than line-by-line.
# Requires a one-time local setup, see README/notes. Without it git
# falls back to the default merge driver, which mangles scenes.
# ---------------------------------------------------------------
*.unity                 merge=unityyamlmerge eol=lf
*.prefab                merge=unityyamlmerge eol=lf
*.asset                 merge=unityyamlmerge eol=lf
*.mat                   merge=unityyamlmerge eol=lf
*.anim                  merge=unityyamlmerge eol=lf
*.controller            merge=unityyamlmerge eol=lf
*.overrideController    merge=unityyamlmerge eol=lf
*.physicMaterial        merge=unityyamlmerge eol=lf
*.physicsMaterial2D     merge=unityyamlmerge eol=lf
*.playable              merge=unityyamlmerge eol=lf
*.mask                  merge=unityyamlmerge eol=lf
*.guiskin               merge=unityyamlmerge eol=lf
*.fontsettings          merge=unityyamlmerge eol=lf
*.flare                 merge=unityyamlmerge eol=lf
*.giparams              merge=unityyamlmerge eol=lf
*.meta                  merge=unityyamlmerge eol=lf

# ---------------------------------------------------------------
# Text
# ---------------------------------------------------------------
*.cs                    text diff=csharp
*.asmdef                text eol=lf
*.asmref                text eol=lf
*.shader                text
*.shadergraph           text
*.hlsl                  text
*.cginc                 text
*.compute               text
*.json                  text
*.md                    text
*.inputactions          text

# ---------------------------------------------------------------
# Managed / native binaries — plain git, not LFS. These are small,
# stable dependency drops (Facepunch, FishNet, MemoryPack) that change
# maybe twice a year; LFS would add quota pressure for no benefit.
# ---------------------------------------------------------------
*.dll                   binary
*.so                    binary
*.dylib                 binary
*.bundle                binary
*.a                     binary
*.pdb                   binary

# ---------------------------------------------------------------
# Git LFS — art and audio. Nothing here yet, but these are the files
# that actually churn and bloat history once content work starts.
# ---------------------------------------------------------------
*.png                   filter=lfs diff=lfs merge=lfs -text
